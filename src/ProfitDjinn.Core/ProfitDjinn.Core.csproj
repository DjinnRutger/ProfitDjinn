<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that is not UI: the data file, the business rules, the invoice PDF.
       No WPF here, so every rule is testable without a window. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProfitDjinn.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProfitDjinn.Tests" />
  </ItemGroup>

</Project>
