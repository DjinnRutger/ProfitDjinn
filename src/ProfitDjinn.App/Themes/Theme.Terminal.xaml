<!--
  Terminal theme: phosphor green on near-black, VT323, square corners, glow instead of
  shadow (custom.css terminal section). Scanlines and flicker are added by MainWindow.
  Same keys as Theme.Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#VT323</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#VT323</FontFamily>

  <SolidColorBrush x:Key="PageBg" Color="#0D0208" />
  <SolidColorBrush x:Key="Surface" Color="#060106" />
  <SolidColorBrush x:Key="SecondaryBg" Color="#060106" />
  <SolidColorBrush x:Key="CardHeaderBg" Color="#080D08" />
  <SolidColorBrush x:Key="TertiaryBg" Color="#060106" />
  <SolidColorBrush x:Key="Text" Color="#00FF41" />
  <SolidColorBrush x:Key="TextMuted" Color="#008F11" />
  <SolidColorBrush x:Key="Heading" Color="#39FF14" />
  <SolidColorBrush x:Key="Border" Color="#5900FF41" />
  <SolidColorBrush x:Key="CardBorder" Color="#5900FF41" />
  <SolidColorBrush x:Key="InputBg" Color="#030303" />
  <SolidColorBrush x:Key="InputBorder" Color="#7300FF41" />
  <SolidColorBrush x:Key="InputPlaceholder" Color="#B3008F11" />
  <SolidColorBrush x:Key="Link" Color="#39FF14" />
  <SolidColorBrush x:Key="LinkHover" Color="#00FF41" />
  <SolidColorBrush x:Key="RowHover" Color="#0D00FF41" />
  <SolidColorBrush x:Key="TotalsRow" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="PendingRow" Color="#0D00FF41" />
  <SolidColorBrush x:Key="Backdrop" Color="#D9000400" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#5900FF41" />

  <SolidColorBrush x:Key="SidebarBorder" Color="#5900FF41" />
  <SolidColorBrush x:Key="SidebarText" Color="#008F11" />
  <SolidColorBrush x:Key="SidebarTextHover" Color="#00FF41" />
  <SolidColorBrush x:Key="SidebarHoverBg" Color="#0D00FF41" />
  <SolidColorBrush x:Key="SidebarActiveText" Color="#39FF14" />
  <SolidColorBrush x:Key="SidebarSection" Color="#008F11" />
  <SolidColorBrush x:Key="SidebarDivider" Color="#5900FF41" />
  <SolidColorBrush x:Key="SidebarBrandText" Color="#39FF14" />
  <SolidColorBrush x:Key="SidebarBrandIcon" Color="#00FF41" />
  <SolidColorBrush x:Key="LogoutText" Color="#008F11" />
  <SolidColorBrush x:Key="LogoutHoverText" Color="#FF4136" />
  <SolidColorBrush x:Key="LogoutHoverBg" Color="#1AFF4136" />

  <SolidColorBrush x:Key="BsPrimary" Color="#39FF14" />
  <SolidColorBrush x:Key="Success" Color="#198754" />
  <SolidColorBrush x:Key="SuccessHover" Color="#157347" />
  <SolidColorBrush x:Key="Info" Color="#0DCAF0" />
  <SolidColorBrush x:Key="Warning" Color="#FFC107" />
  <SolidColorBrush x:Key="Danger" Color="#DC3545" />
  <SolidColorBrush x:Key="DangerText" Color="#FF4136" />
  <SolidColorBrush x:Key="SuccessText" Color="#00FF41" />
  <SolidColorBrush x:Key="Secondary" Color="#6C757D" />
  <SolidColorBrush x:Key="SecondaryHover" Color="#5C636A" />
  <SolidColorBrush x:Key="PrimaryTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="SuccessTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="InfoTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="WarningTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="DangerTint" Color="#1AFF4136" />
  <SolidColorBrush x:Key="WarningBorder50" Color="#80FFD700" />
  <SolidColorBrush x:Key="DangerBorder50" Color="#80FF4136" />
  <SolidColorBrush x:Key="StatusActive" Color="#00FF41" />
  <SolidColorBrush x:Key="StatusInactive" Color="#008F11" />

  <!-- stat tiles: every value bright green with glow, icon on a green tint (custom.css terminal) -->
  <SolidColorBrush x:Key="Stat.Primary" Color="#39FF14" />
  <SolidColorBrush x:Key="Stat.Info" Color="#39FF14" />
  <SolidColorBrush x:Key="Stat.Warning" Color="#39FF14" />
  <SolidColorBrush x:Key="Stat.Danger" Color="#39FF14" />
  <SolidColorBrush x:Key="Stat.Success" Color="#39FF14" />
  <SolidColorBrush x:Key="Stat.PrimaryTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="Stat.InfoTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="Stat.WarningTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="Stat.DangerTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="Stat.SuccessTint" Color="#1A00FF41" />
  <SolidColorBrush x:Key="Stat.Bar" Color="#00FF41" />

  <!-- terminal badges: outlined, green; danger red -->
  <SolidColorBrush x:Key="Badge.Success.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Success75.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Info.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Info75.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Warning.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Danger.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Secondary.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Secondary50.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Primary.Bg" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.Fg" Color="#00FF41" />
  <SolidColorBrush x:Key="Badge.DarkFg" Color="#00FF41" />
  <SolidColorBrush x:Key="Badge.DangerFg" Color="#FF4136" />
  <SolidColorBrush x:Key="Badge.Border" Color="#00FF41" />
  <SolidColorBrush x:Key="Badge.DangerBorder" Color="#FF4136" />

  <SolidColorBrush x:Key="Alert.Success.Bg" Color="#060106" />
  <SolidColorBrush x:Key="Alert.Success.Fg" Color="#00FF41" />
  <SolidColorBrush x:Key="Alert.Success.Border" Color="#00FF41" />
  <SolidColorBrush x:Key="Alert.Danger.Bg" Color="#060106" />
  <SolidColorBrush x:Key="Alert.Danger.Fg" Color="#FF4136" />
  <SolidColorBrush x:Key="Alert.Danger.Border" Color="#FF4136" />
  <SolidColorBrush x:Key="Alert.Warning.Bg" Color="#060106" />
  <SolidColorBrush x:Key="Alert.Warning.Fg" Color="#FFD700" />
  <SolidColorBrush x:Key="Alert.Warning.Border" Color="#FFD700" />
  <SolidColorBrush x:Key="Alert.Info.Bg" Color="#060106" />
  <SolidColorBrush x:Key="Alert.Info.Fg" Color="#008F11" />
  <SolidColorBrush x:Key="Alert.Info.Border" Color="#008F11" />
  <Thickness x:Key="AlertBorderThickness">3,0,0,0</Thickness>

  <CornerRadius x:Key="Radius">0</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">0</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">0</CornerRadius>
  <CornerRadius x:Key="RadiusIconBox">0</CornerRadius>
  <CornerRadius x:Key="RadiusNavBar">0</CornerRadius>

  <DropShadowEffect x:Key="ShadowXs" ShadowDepth="0" BlurRadius="6" Opacity="0.10" Color="#00FF41" />
  <DropShadowEffect x:Key="ShadowSm" ShadowDepth="0" BlurRadius="12" Opacity="0.12" Color="#00FF41" />
  <DropShadowEffect x:Key="ShadowMd" ShadowDepth="0" BlurRadius="18" Opacity="0.20" Color="#00FF41" />
  <DropShadowEffect x:Key="ShadowLg" ShadowDepth="0" BlurRadius="20" Opacity="0.20" Color="#00FF41" />
  <DropShadowEffect x:Key="ShadowDialog" ShadowDepth="0" BlurRadius="40" Opacity="0.20" Color="#00FF41" />
  <DropShadowEffect x:Key="HeadingGlow" ShadowDepth="0" BlurRadius="12" Opacity="0.8" Color="#00FF41" />
  <DropShadowEffect x:Key="TextGlow" ShadowDepth="0" BlurRadius="6" Opacity="0.5" Color="#00FF41" />

  <SolidColorBrush x:Key="ChartGrid" Color="#3300FF41" />
  <SolidColorBrush x:Key="ChartLabel" Color="#008F11" />
  <SolidColorBrush x:Key="ChartBar" Color="#CC00FF41" />
  <SolidColorBrush x:Key="ChartBarHover" Color="#39FF14" />
  <SolidColorBrush x:Key="TooltipBg" Color="#EB060106" />
  <SolidColorBrush x:Key="TooltipFg" Color="#00FF41" />
</ResourceDictionary>
