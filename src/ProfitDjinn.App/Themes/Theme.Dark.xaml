<!--
  Dark theme: Bootstrap 5.3.3 dark with custom.css's GitHub-style overrides
  (page #0d1117, cards #161b22, borders #30363d). Same keys as Theme.Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="BodyFont">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <SolidColorBrush x:Key="PageBg" Color="#0D1117" />
  <SolidColorBrush x:Key="Surface" Color="#161B22" />
  <SolidColorBrush x:Key="SecondaryBg" Color="#343A40" />
  <SolidColorBrush x:Key="CardHeaderBg" Color="#343A40" />
  <SolidColorBrush x:Key="TertiaryBg" Color="#2B3035" />
  <SolidColorBrush x:Key="Text" Color="#E6EDF3" />
  <SolidColorBrush x:Key="TextMuted" Color="#BFDEE2E6" />
  <SolidColorBrush x:Key="Heading" Color="#E6EDF3" />
  <SolidColorBrush x:Key="Border" Color="#30363D" />
  <SolidColorBrush x:Key="CardBorder" Color="#30363D" />
  <SolidColorBrush x:Key="InputBg" Color="#212529" />
  <SolidColorBrush x:Key="InputBorder" Color="#495057" />
  <SolidColorBrush x:Key="InputPlaceholder" Color="#8CADB5BD" />
  <SolidColorBrush x:Key="Link" Color="#6EA8FE" />
  <SolidColorBrush x:Key="LinkHover" Color="#8BB9FE" />
  <SolidColorBrush x:Key="RowHover" Color="#13FFFFFF" />
  <SolidColorBrush x:Key="TotalsRow" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="PendingRow" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Backdrop" Color="#B3010409" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#40FFFFFF" />

  <SolidColorBrush x:Key="SidebarBorder" Color="Transparent" />
  <SolidColorBrush x:Key="SidebarText" Color="#94A3B8" />
  <SolidColorBrush x:Key="SidebarTextHover" Color="#E2E8F0" />
  <SolidColorBrush x:Key="SidebarHoverBg" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="SidebarActiveText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarSection" Color="#475569" />
  <SolidColorBrush x:Key="SidebarDivider" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SidebarBrandText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarBrandIcon" Color="#60A5FA" />
  <SolidColorBrush x:Key="LogoutText" Color="#64748B" />
  <SolidColorBrush x:Key="LogoutHoverText" Color="#F87171" />
  <SolidColorBrush x:Key="LogoutHoverBg" Color="#1AEF4444" />

  <SolidColorBrush x:Key="BsPrimary" Color="#0D6EFD" />
  <SolidColorBrush x:Key="Success" Color="#198754" />
  <SolidColorBrush x:Key="SuccessHover" Color="#157347" />
  <SolidColorBrush x:Key="Info" Color="#0DCAF0" />
  <SolidColorBrush x:Key="Warning" Color="#FFC107" />
  <SolidColorBrush x:Key="Danger" Color="#DC3545" />
  <SolidColorBrush x:Key="DangerText" Color="#EA868F" />
  <SolidColorBrush x:Key="SuccessText" Color="#75B798" />
  <SolidColorBrush x:Key="Secondary" Color="#6C757D" />
  <SolidColorBrush x:Key="SecondaryHover" Color="#5C636A" />
  <SolidColorBrush x:Key="PrimaryTint" Color="#1A0D6EFD" />
  <SolidColorBrush x:Key="SuccessTint" Color="#1A198754" />
  <SolidColorBrush x:Key="InfoTint" Color="#1A0DCAF0" />
  <SolidColorBrush x:Key="WarningTint" Color="#1AFFC107" />
  <SolidColorBrush x:Key="DangerTint" Color="#1ADC3545" />
  <SolidColorBrush x:Key="WarningBorder50" Color="#80FFC107" />
  <SolidColorBrush x:Key="DangerBorder50" Color="#80DC3545" />
  <SolidColorBrush x:Key="StatusActive" Color="#22C55E" />
  <SolidColorBrush x:Key="StatusInactive" Color="#94A3B8" />

  <!-- stat tiles: text-{tone} on a bg-{tone} 10% tint -->
  <SolidColorBrush x:Key="Stat.Primary" Color="#0D6EFD" />
  <SolidColorBrush x:Key="Stat.Info" Color="#0DCAF0" />
  <SolidColorBrush x:Key="Stat.Warning" Color="#FFC107" />
  <SolidColorBrush x:Key="Stat.Danger" Color="#DC3545" />
  <SolidColorBrush x:Key="Stat.Success" Color="#198754" />
  <SolidColorBrush x:Key="Stat.PrimaryTint" Color="#1A0D6EFD" />
  <SolidColorBrush x:Key="Stat.InfoTint" Color="#1A0DCAF0" />
  <SolidColorBrush x:Key="Stat.WarningTint" Color="#1AFFC107" />
  <SolidColorBrush x:Key="Stat.DangerTint" Color="#1ADC3545" />
  <SolidColorBrush x:Key="Stat.SuccessTint" Color="#1A198754" />
  <SolidColorBrush x:Key="Stat.Bar" Color="#198754" />

  <SolidColorBrush x:Key="Badge.Success.Bg" Color="#198754" />
  <SolidColorBrush x:Key="Badge.Success75.Bg" Color="#BF198754" />
  <SolidColorBrush x:Key="Badge.Info.Bg" Color="#0DCAF0" />
  <SolidColorBrush x:Key="Badge.Info75.Bg" Color="#BF0DCAF0" />
  <SolidColorBrush x:Key="Badge.Warning.Bg" Color="#FFC107" />
  <SolidColorBrush x:Key="Badge.Danger.Bg" Color="#DC3545" />
  <SolidColorBrush x:Key="Badge.Secondary.Bg" Color="#6C757D" />
  <SolidColorBrush x:Key="Badge.Secondary50.Bg" Color="#806C757D" />
  <SolidColorBrush x:Key="Badge.Primary.Bg" Color="#0D6EFD" />
  <SolidColorBrush x:Key="Badge.Fg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Badge.DarkFg" Color="#212529" />
  <SolidColorBrush x:Key="Badge.DangerFg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Badge.Border" Color="Transparent" />
  <SolidColorBrush x:Key="Badge.DangerBorder" Color="Transparent" />

  <SolidColorBrush x:Key="Alert.Success.Bg" Color="#051B11" />
  <SolidColorBrush x:Key="Alert.Success.Fg" Color="#75B798" />
  <SolidColorBrush x:Key="Alert.Success.Border" Color="#0F5132" />
  <SolidColorBrush x:Key="Alert.Danger.Bg" Color="#2C0B0E" />
  <SolidColorBrush x:Key="Alert.Danger.Fg" Color="#EA868F" />
  <SolidColorBrush x:Key="Alert.Danger.Border" Color="#842029" />
  <SolidColorBrush x:Key="Alert.Warning.Bg" Color="#332701" />
  <SolidColorBrush x:Key="Alert.Warning.Fg" Color="#FFDA6A" />
  <SolidColorBrush x:Key="Alert.Warning.Border" Color="#997404" />
  <SolidColorBrush x:Key="Alert.Info.Bg" Color="#032830" />
  <SolidColorBrush x:Key="Alert.Info.Fg" Color="#6EDFF6" />
  <SolidColorBrush x:Key="Alert.Info.Border" Color="#087990" />
  <Thickness x:Key="AlertBorderThickness">1</Thickness>

  <CornerRadius x:Key="Radius">8</CornerRadius>
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">12</CornerRadius>
  <CornerRadius x:Key="RadiusIconBox">12</CornerRadius>
  <CornerRadius x:Key="RadiusNavBar">0,3,3,0</CornerRadius>

  <DropShadowEffect x:Key="ShadowXs" ShadowDepth="1" BlurRadius="2" Opacity="0.30" Direction="270" />
  <DropShadowEffect x:Key="ShadowSm" ShadowDepth="1" BlurRadius="4" Opacity="0.35" Direction="270" />
  <DropShadowEffect x:Key="ShadowMd" ShadowDepth="3" BlurRadius="8" Opacity="0.40" Direction="270" />
  <DropShadowEffect x:Key="ShadowLg" ShadowDepth="8" BlurRadius="16" Opacity="0.40" Direction="270" />
  <DropShadowEffect x:Key="ShadowDialog" ShadowDepth="8" BlurRadius="40" Opacity="0.50" Direction="270" />
  <x:Null x:Key="HeadingGlow" />
  <x:Null x:Key="TextGlow" />

  <SolidColorBrush x:Key="ChartGrid" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="ChartLabel" Color="#ADB5BD" />
  <SolidColorBrush x:Key="ChartBar" Color="#D93B6FB6" />
  <SolidColorBrush x:Key="ChartBarHover" Color="#3B6FB6" />
  <SolidColorBrush x:Key="TooltipBg" Color="#EB0F172A" />
  <SolidColorBrush x:Key="TooltipFg" Color="#E2E8F0" />
</ResourceDictionary>
